# Copy to .env.local for local `vercel dev`, and set the same keys in the
# Vercel project's Environment Variables settings for Preview/Production.
# Never commit a file containing real values — only this template.

CLIENT_ID=
CLIENT_SECRET=
X_API_KEY=
TOKEN_URL=https://login.microsoftonline.com/organizations/oauth2/v2.0/token
SCOPE_URL=https://tapi.dvsa.gov.uk/.default

# Comma-separated list of origins allowed to call /api/mot, e.g.
# https://car-qc.example.com,https://www.car-qc.example.com
# Leave unset locally; set it once you know your production domain(s).
ALLOWED_ORIGINS=
